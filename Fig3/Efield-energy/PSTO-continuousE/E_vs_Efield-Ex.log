
#######################################
###       可调整参数（集中区）      ###
#######################################
# 系统参数
variable        Temp equal 1          # 温度(K)
variable        P equal 0               # 压力(bar)
variable        timestep equal 0.002    # 时间步长(ps) f = 0.001/T THz (0.5THz)

# 电场参数
variable        E_max equal 0.05       # 最大电场强度(V/Å) & MV/cm (反向电场)
variable        init_steps equal 50000   # 初始上升阶段步数（增加步数让电场上升更慢）

# 数据输出
variable        thermo_freq equal 10    # 热力学输出频率
variable        dump_freq equal 10      # 结构输出频率

# 区域电场参数 - 从第二个脚本借鉴
variable        xmin equal 0           # 特定区域的x最小值
variable        xmax equal 100           # 特定区域的x最大值
variable        ymin equal 0           # 特定区域的y最小值
variable        ymax equal 100           # 特定区域的y最大值
variable        zmin equal 50          # 特定区域的z最小值
variable        zmax equal 110          # 特定区域的z最大值

#######################################
###         初始化部分              ###
#######################################
dimension       3
boundary        p p p
units           metal
atom_style      bec                     # 仍需保留bec原子样式以支持电场
newton          on

# 读取系统
read_data       in.data
Reading data file ...
  triclinic box = (0.0000000 0.0000000 0.0000000) to (63.024684 63.338494 106.03224) with tilt (0.0000000 0.0000000 0.0000000)
  4 by 4 by 4 MPI processor grid
  reading atoms ...
  33280 atoms
  read_data CPU = 0.247 seconds
mass            1 16 #O
mass            2 47.9 #Ti
mass            3 87.6 #Sr
mass            4 207.2 #Pb

# 设置力场
pair_style      allegro
pair_coeff      * * ../PSTO-bec.pth O Ti Sr Pb

# 基本设置
timestep        ${timestep}
timestep        0.002
neighbor        0.05 bin
neigh_modify    every 1 delay 0 check yes

# 输出设置 - 只包含基本信息
thermo          ${thermo_freq}
thermo          10
thermo_style    custom step temp ke pe etotal

# 定义区域电场 - 从第二个脚本借鉴
region          efield_region block ${xmin} ${xmax} ${ymin} ${ymax} ${zmin} ${zmax}
region          efield_region block 0 ${xmax} ${ymin} ${ymax} ${zmin} ${zmax}
region          efield_region block 0 100 ${ymin} ${ymax} ${zmin} ${zmax}
region          efield_region block 0 100 0 ${ymax} ${zmin} ${zmax}
region          efield_region block 0 100 0 100 ${zmin} ${zmax}
region          efield_region block 0 100 0 100 50 ${zmax}
region          efield_region block 0 100 0 100 50 110
group           efield_group region efield_region
17152 atoms in group efield_group

#######################################
###     只保留第一阶段电场循环      ###
#######################################
# 初始平衡
velocity        all create ${Temp} 12345 dist gaussian
velocity        all create 1 12345 dist gaussian
fix             equil all npt temp ${Temp} ${Temp} 0.1 aniso ${P} ${P} 1.0
fix             equil all npt temp 1 ${Temp} 0.1 aniso ${P} ${P} 1.0
fix             equil all npt temp 1 1 0.1 aniso ${P} ${P} 1.0
fix             equil all npt temp 1 1 0.1 aniso 0 ${P} 1.0
fix             equil all npt temp 1 1 0.1 aniso 0 0 1.0
# 添加消除整体动量的fix
fix             mom all momentum 10 linear 1 1 1 #每10步消除一次x、y、z方向的线性动量
run             1000
