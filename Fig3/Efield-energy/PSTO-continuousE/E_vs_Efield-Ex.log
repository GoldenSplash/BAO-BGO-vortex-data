unfix           equil

# 定义电场变量和NPT控制 - 移除极化数据输出
variable        efield equal 0.0
fix             md all npt temp ${Temp} ${Temp} 0.1 aniso ${P} ${P} 1.0
fix             md all npt temp 1 ${Temp} 0.1 aniso ${P} ${P} 1.0
fix             md all npt temp 1 1 0.1 aniso ${P} ${P} 1.0
fix             md all npt temp 1 1 0.1 aniso 0 ${P} 1.0
fix             md all npt temp 1 1 0.1 aniso 0 0 1.0

# 只保留阶段1: 0 → +E_max
print "======== 阶段1: 0 → +E_max ========"
WARNING: Detected non-ASCII characters in input. Will try to continue by replacing with ASCII equivalents where known. (src/input.cpp:431)
======== ����1: 0 �� +E_max ========
variable        E_rate equal ${E_max}/${init_steps}
variable        E_rate equal 0.05/${init_steps}
variable        E_rate equal 0.05/50000
dump            d1 all atom ${dump_freq} Efield.dump
dump            d1 all atom 10 Efield.dump
variable        efield equal ${E_rate}*(step-1000)
variable        efield equal 1e-06*(step-1000)
# 只对特定区域应用电场
fix             field efield_group efield v_efield 0.0 0.0
run             ${init_steps}
run             50000
